# Ruta al inventario de hosts (JSON)
SYSADMIN_INVENTORY_PATH=./config/inventory.json

# === PRODUCCIÓN (activar siempre en prod) ===
SYSADMIN_PRODUCTION_MODE=true
# Token humano: el LLM no lo conoce; tú lo pasas al aprobar operaciones destructivas
SYSADMIN_CONFIRM_TOKEN=change-me-to-a-long-random-secret

# Modo solo lectura global (bloquea ssh-exec, vm-power, snapshots)
SYSADMIN_READ_ONLY=false

# Exigir confirm=true en operaciones destructivas (mantener true en prod)
SYSADMIN_REQUIRE_CONFIRM=true

# Rate limit: max llamadas por tool+host por ventana
SYSADMIN_RATE_LIMIT_MAX=30
SYSADMIN_RATE_LIMIT_WINDOW_MS=60000

# Nivel de log: debug | info | warn | error
SYSADMIN_LOG_LEVEL=info

# Timeout HTTP para APIs (ms)
SYSADMIN_HTTP_TIMEOUT_MS=30000

# Timeout SSH (ms)
SYSADMIN_SSH_TIMEOUT_MS=30000

# Credenciales por host (referenciadas en inventory con ${VAR})
# PROXMOX_HOMELAB_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VIRTUALIZOR_API_KEY=your_key
# VIRTUALIZOR_API_PASS=your_pass
