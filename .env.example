# Ruta al inventario de hosts (JSON)
SYSADMIN_INVENTORY_PATH=./config/inventory.json

# Nivel de log: debug | info | warn | error
SYSADMIN_LOG_LEVEL=info

# Modo solo lectura global (bloquea ssh-exec, vm-power destructivo, snapshots)
SYSADMIN_READ_ONLY=false

# Exigir confirm=true en operaciones destructivas (default: true si no se define)
SYSADMIN_REQUIRE_CONFIRM=true

# Timeout HTTP para APIs (ms)
SYSADMIN_HTTP_TIMEOUT_MS=30000

# Timeout SSH (ms)
SYSADMIN_SSH_TIMEOUT_MS=30000

# Credenciales opcionales por host (referenciadas en inventory con ${VAR})
# PROXMOX_HOMELAB_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VIRTUALIZOR_API_KEY=your_key
# VIRTUALIZOR_API_PASS=your_pass
