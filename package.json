{
  "name": "mcp-sysadmin",
  "version": "1.4.0",
  "description": "Provider-agnostic MCP server for physical servers, Proxmox, Virtualizor, Hetzner Cloud, Cloudflare, and SSH hosts.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-sysadmin": "dist/index.js"
  },
  "files": [
    "dist",
    ".env.example",
    "config/inventory.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "sysadmin",
    "proxmox",
    "virtualizor",
    "hetzner",
    "cloudflare",
    "ssh",
    "infrastructure"
  ],
  "author": "kreodevs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kreodevs/mcp-sysadmin.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.17.0",
    "dotenv": "^17.4.2",
    "ssh2": "^1.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/ssh2": "^1.15.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
